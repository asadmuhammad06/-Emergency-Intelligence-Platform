# ================================================================
# Emergency Intelligence Platform — Backend Environment Configuration
# ================================================================

# PORT configuration
PORT=3001

# Alibaba DashScope / Qwen-VL Vision API Key
# Optional: Set this key to enable live cloud inference on arbitrary uploaded photos.
# If omitted, the platform runs in calibrated disaster simulation & on-prem vision heuristic mode.
DASHSCOPE_API_KEY=

# Optional: OpenAI / Gemini / Compatible endpoint key
OPENAI_API_KEY=

# Node Environment
NODE_ENV=development

